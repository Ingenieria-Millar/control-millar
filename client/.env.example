# ============================================
# PUNTO SEGURO — Frontend (client/.env)
# ============================================

# URL base de la API. En desarrollo, Vite ya la redirige vía proxy (vite.config.js),
# así que normalmente puedes dejar esto vacío o apuntando a "/api".
VITE_API_BASE_URL=/api

# URL del menú principal de Millar (para el botón "← Volver al Menú")
# Dejar vacío en desarrollo; configurar en Render con la URL del MES
VITE_MILLAR_URL=
