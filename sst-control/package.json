{
  "name": "control-visitantes-sst",
  "version": "1.0.0",
  "description": "Aplicativo de control de visitantes y salidas de personal para cumplimiento SST",
  "private": true,
  "scripts": {
    "start": "npx serve . -p 3000 --no-clipboard",
    "dev": "npx serve . -p 3000",
    "lint": "node -e \"const fs=require('fs'),re=/<script(?! src)[^>]*>([\\s\\S]*?)<\\/script>/;const m=re.exec(fs.readFileSync('index.html','utf8'));if(!m){console.log('No inline script');process.exit(0);}require('child_process').execSync('node --check /dev/stdin',{input:m[1],stdio:['pipe','inherit','inherit']});console.log('JS OK');\""
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "keywords": [
    "SST",
    "visitantes",
    "control-acceso",
    "seguridad-trabajo",
    "colombia"
  ],
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "serve": "^14.2.4"
  }
}
