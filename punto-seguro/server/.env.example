# ============================================
# PUNTO SEGURO — Backend (server/.env)
# ============================================

# Entorno: development | production | test
NODE_ENV=development

# Puerto donde escucha Express (Render inyecta PORT automáticamente)
PORT=4000

# Cadena de conexión a PostgreSQL
# Local:      postgresql://usuario:password@localhost:5432/punto_seguro
# Render:     se inyecta automáticamente vía render.yaml (fromDatabase)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/punto_seguro

# Secreto para firmar tokens de enlaces públicos (onboarding, quiz, firma)
# Genera uno fuerte con: openssl rand -hex 32
JWT_SECRET=change-this-to-a-strong-random-secret

# Origen(es) permitidos para CORS (separados por coma). Usa "*" solo en desarrollo.
CORS_ORIGIN=http://localhost:5173

# Tamaño máximo de subida de archivos (PDFs / Excel), en MB
MAX_UPLOAD_MB=15
